  "web_exit": {
    "strategy": "close_then_history_back",
    "history_back_steps": 2,
    "verification_delay_ms": 400
  },
  "quality_assurance": {
    "base_url": "http://127.0.0.1:4173",
    "web_server_command": "npm run preview",
    "server_timeout_ms": 120000,
    "worker_count": 1,
    "action_timeout_ms": 10000,
    "navigation_timeout_ms": 30000,
    "screenshot_directory": "artifacts/qa",
    "trace_mode": "retain-on-failure",
    "mobile_user_agent": "Mozilla/5.0 (Linux; Android 14; Pixel 7) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Mobile Safari/537.36",
    "minimum_touch_css_px": 44,
    "keyboard_simulated_height_px": 240,
    "keyboard_minimum_viewport_height_px": 280,
    "scroll_drag_ratio": 0.6,
    "scroll_drag_steps": 8,
    "scroll_max_attempts": 6,
    "scroll_settle_ms": 80
  },
