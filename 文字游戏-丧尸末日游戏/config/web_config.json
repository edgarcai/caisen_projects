    "mobile_design_height": 1067,
    "scale_mode": "fixedauto",
    "desktop_screen_mode": "none",
    "mobile_screen_mode": "none",
    "align_horizontal": "center",
    "align_vertical": "middle",
    "retina_canvas": false,
    "active_frame_mode": "fast",
