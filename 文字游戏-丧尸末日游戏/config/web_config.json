    "desktop_dialog_height": 330,
    "mobile_dialog_height": 470,
    "fallback_target_width": 260,
    "fallback_target_height": 120,
    "steps": [
      {
        "id": "commander-status",
        "speaker": "基地指挥官·豪菜",
        "title": "先认识你自己",
        "instruction": "这里显示当前行动者和生存状态。生命、饥饿与希望中任何一项失控，都可能终结这次生存。",
        "target_test_id": "dashboard-active-player"
      },
      {
        "id": "resources",
        "speaker": "基地指挥官·豪菜",
        "title": "读懂库存",
        "instruction": "食物维持人群，零件用于修复与研发，医疗用品保住远征队的命。每次出发前都要检查余量。",
        "target_test_id": "dashboard-resource-player-food"
      },
      {
        "id": "exploration",
        "speaker": "侦察员·阳关",
        "title": "规划第一次远征",
        "instruction": "点击探索，先查看城市通行需求，再选区划、同行伙伴与携带物。H 市是没有邻城的孤岛，必须在载具设置中同时装备海上与飞行载具才能进入。城市路程与区划事件都会消耗步数。",
        "target_test_id": "dashboard-action-explore"
      },
      {
        "id": "shelter-management",
        "speaker": "基地指挥官·豪菜",
        "title": "稳住避难所",
        "instruction": "避难所管理分为经营、活动与升级。初始区域的设施总等级上限是 10；先完成区域扩张，才能继续升级并建造新设施。贸易每个生存周只能完成一次，运输途中还可能遭遇抢劫。",
        "target_test_id": "dashboard-action-shelter_management"
      },
      {
        "id": "companions",
        "speaker": "通讯员·小满",
        "title": "伙伴不是数值",
        "instruction": "从伙伴档案查看状态、立绘和完整档案，也可以为他们配装或互动。信任与特性会改变远征能力。",
        "target_test_id": "dashboard-action-companions"
      },
      {
        "id": "communication-log",
        "speaker": "基地指挥官·豪菜",
        "title": "记住发生过什么",
        "instruction": "中央通讯栏记录当周行动，七日后会封存到历史记录。当你忘记上一步做了什么，先来这里。",
        "target_test_id": "dashboard-log"
      },
      {
        "id": "save-and-settings",
        "speaker": "基地指挥官·豪菜",
        "title": "暂停与存档",
        "instruction": "按 ESC 打开功能菜单，可以存档、设置、回档或返回主菜单。v7 存档会保留已装备载具、区域扩张与当周贸易次数；完整教程也可随时从设置里重新打开。",
        "target_test_id": "dashboard-settings"
      }
    ]
  },
