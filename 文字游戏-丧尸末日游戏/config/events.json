{
  "schema_version": 1,
  "events": [
    {
      "id": "bank",
      "category": "discovery",
      "weight": 1,
      "title": "废弃银行",
      "intro": "你来到一家门窗破碎的银行，柜台后仍有可以使用的旧硬币。",
      "outcomes": [
        {
          "weight": 3,
          "result": "你撬开了半掩的保险柜，带回{coins}枚仍被聚落认可的旧金币。",
          "effects": [
            {"target": "player.coins", "operation": "add", "amount": [50, 89], "token": "coins"}
          ]
        },
        {
          "weight": 1,
          "result": "金库警报突然复鸣，尸群撞破侧门。你负伤{damage}点，只抢出{coins}枚金币。",
          "effects": [
            {"target": "player.health", "operation": "subtract", "amount": [8, 24], "token": "damage"},
            {"target": "player.coins", "operation": "add", "amount": [20, 46], "token": "coins"}
          ]
        },
        {
          "weight": 1,
          "result": "柜台里的钞票早已失去价值，但保安室地图夹着{newspapers}份灾变报纸和{parts}个门禁零件。",
          "effects": [
            {"target": "shelter.newspapers", "operation": "add", "amount": [2, 5], "token": "newspapers"},
            {"target": "player.parts", "operation": "add", "amount": [4, 12], "token": "parts"}
          ]
        },
        {
          "weight": 1,
          "result": "埋伏者从柜台后举枪，你丢下{coins}枚金币才冲出大厅。",
          "effects": [
            {"target": "player.coins", "operation": "subtract", "amount": [5, 25], "token": "coins", "limit_to_available": true}
          ]
        }
      ]
    },
    {
      "id": "elder",
      "category": "discovery",
      "weight": 1,
      "title": "街角的老人",
      "intro": "一位饥饿的老人靠在路牌旁，腰间别着一把保存完好的猎刀。",
      "choices": [
        {
          "id": "help",
          "label": "给他10份食物",
          "requirements": [
            {"target": "player.food", "operator": "gte", "value": 10}
          ],
          "result": "老人收下食物，把猎刀交给你。食物-{food_cost}，攻击+{attack_gain}。",
          "effects": [
            {"target": "player.food", "operation": "subtract", "amount": 10, "token": "food_cost"},
            {"target": "player.attack", "operation": "add", "amount": 10, "token": "attack_gain"}
          ]
        },
        {
          "id": "leave",
          "label": "谨慎离开",
          "result": "你向老人点头致意，保持距离离开了街角。",
          "effects": []
        }
      ]
    },
    {
      "id": "medical_pod",
      "category": "discovery",
      "weight": 1,
      "title": "大型医疗仓",
      "intro": "一台应急医疗仓仍有电力，舱门上的绿灯正在闪烁。",
      "result": "医疗仓完成了全身治疗，你的生命恢复至{health}。",
      "effects": [
        {"target": "player.health", "operation": "set", "amount": 100, "token": "health"}
      ]
    },
    {
