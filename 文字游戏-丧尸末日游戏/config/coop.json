{
  "schema_version": 1,
  "channel_prefix": "shelter-past-coop-v2",
  "account_storage_key": "shelter-past-local-account-v1",
  "transport": {
    "websocket_enabled": true,
    "websocket_path": "/coop",
    "namespace": "shelter-past-v1",
    "outbound_queue_limit": 100,
    "reconnect_delay_ms": 1200,
    "maximum_reconnect_attempts": 8,
    "relay_upstream": "ws://127.0.0.1:4191",
    "relay_host": "0.0.0.0",
    "relay_port": 4191,
    "relay_max_payload_bytes": 32768,
    "relay_heartbeat_ms": 30000
  },
  "rules": {
    "maximum_name_characters": 18,
    "maximum_room_characters": 36,
    "maximum_message_characters": 120,
    "maximum_events": 80,
    "trade_offer_ttl_ms": 600000
  },
